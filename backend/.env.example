# Backend Environment Variables Example
# Set these on your deployment platform (e.g. Render, Railway, AWS, Docker) or in Aiven MySQL:

# Database connection
DB_URL=jdbc:mysql://localhost:3306/factory_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=root

# Server port
PORT=8080

# JWT Secret & Expiration
JWT_SECRET=MyFactoryManagementSuperSecretKeyThatIsAtLeast256BitsLong2024!
JWT_EXPIRATION=36000000

# Hibernate mode (use 'validate' or 'update' in production)
HIBERNATE_DDL_AUTO=update
